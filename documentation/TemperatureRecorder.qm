<?xml version="1.0" encoding="UTF-8"?>
<model version="7.0.3" links="0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.state-machine.com/qm/qm7.xsd">
 <framework name="qpc"/>
 <package name="AOs" stereotype="0x02">
  <class name="TemperatureRecorder" superclass="qpc::QMActive">
   <attribute name="TimeEvt" type="QTimeEvt" visibility="0x02" properties="0x00"/>
   <statechart properties="0x00">
    <initial target="../1">
     <action brief="BSP_tmp117_init();"/>
     <initial_glyph conn="2,5,5,0,17,7">
      <action box="0,-2,19,2"/>
     </initial_glyph>
    </initial>
    <state name="wait4start">
     <entry>BSP_ledGreenOn();</entry>
     <exit>BSP_ledGreenOff();</exit>
     <tran trig="START_RECORDING" target="../../2">
      <tran_glyph conn="2,26,3,1,52,9,-2">
       <action box="0,-2,18,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="2,12,32,17">
      <entry box="0,3,18,4"/>
      <exit box="0,7,18,4"/>
     </state_glyph>
    </state>
    <state name="recording">
     <entry>BSP_ledBlueOn();
TimeEvent_arm(...);
record_temperature(...);</entry>
     <exit>BSP_ledBlueOff();
reset_recording(...);</exit>
     <tran trig="TIMEOUT">
      <action brief="record_temperature(...); TimeEvent_arm(recording_period);"/>
      <tran_glyph conn="2,55,3,-1,36">
       <action box="0,-3,50,3"/>
      </tran_glyph>
     </tran>
     <tran trig="REPORT_TEMPERATURE">
      <action brief="report_temperature_cb(...);"/>
      <tran_glyph conn="2,61,3,-1,36">
       <action box="0,-3,39,3"/>
      </tran_glyph>
     </tran>
     <tran trig="RESET_RECORDING">
      <action brief="reset_recording(...);"/>
      <tran_glyph conn="2,67,3,-1,36">
       <action box="0,-3,34,3"/>
      </tran_glyph>
     </tran>
     <tran trig="STOP_RECORDING" target="../../1">
      <tran_glyph conn="2,72,3,1,54,-52,-22">
       <action box="0,-2,16,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="2,32,50,52">
      <entry box="0,3,25,8"/>
      <exit box="0,11,26,6"/>
     </state_glyph>
    </state>
    <state_diagram size="62,88"/>
   </statechart>
  </class>
 </package>
</model>
